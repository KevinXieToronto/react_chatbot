{
  "name": "taskflow-cli",
  "version": "1.0.0",
  "private": true,
  "description": "TaskFlow 编码 Agent 的终端客户端（React + Ink）",
  "type": "module",
  "bin": {
    "taskflow": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "lowlight": "^3.3.0",
    "marked": "^18.0.14",
    "react": "^19.2.8",
    "string-width": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@taskflow/agent-core": "*",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
